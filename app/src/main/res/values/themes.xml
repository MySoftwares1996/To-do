<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.OfficeToDo" parent="Theme.Material3.DayNight">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="Theme.OfficeToDo.Alarm" parent="Theme.OfficeToDo">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/alarm_bg</item>
        <item name="android:statusBarColor">@color/alarm_bg</item>
        <item name="android:navigationBarColor">@color/alarm_bg</item>
    </style>

    <!-- Section headers in the task list -->
    <style name="SectionHeader">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
