<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg">

    <!-- Large title that shrinks into a centred title on scroll -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ios_bg"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <!-- One-line title bar: title + summary on the left, search and + on the right -->
        <!-- Title bar: grows with the phone's text size so nothing is cut off -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:background="@color/ios_bg"
            app:contentInsetStart="16dp"
            app:titleCentered="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:orientation="vertical"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/ios_label"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/header_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/ios_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- Hairline under the title bar so scrolled content never looks cut -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0.6dp"
            android:background="@color/ios_separator" />

        <!-- Search bar (task tabs only) -->
        <EditText
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_search"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="8dp"
            android:hint="@string/ui_search_tasks_notes_categories"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="10dp"
            android:textColor="@color/ios_label"
            android:textColorHint="@color/ios_secondary"
            android:textSize="16sp"
            android:visibility="gone" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutAnimation="@anim/list_drop_in"
        android:clipToPadding="false"
        android:paddingHorizontal="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="84dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Settings tab content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/settings_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="84dp"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Filled from code (MainActivity.refreshSettings) -->
        <LinearLayout
            android:id="@+id/settings_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="10dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom tabs -->
    <!-- Bottom tabs: selected tab is a coloured pill with icon + label (animated) -->
    <com.mysoftwares.todo.PillTabBar
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_tab_bar" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
