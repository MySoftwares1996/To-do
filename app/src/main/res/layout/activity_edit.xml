<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_bg"
    android:orientation="vertical">

    <!-- Top bar: Cancel | Title | Add -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <TextView
            android:id="@+id/bar_cancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Cancel"
            android:textColor="?attr/colorPrimary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/bar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/ios_label"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bar_save"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Add"
            android:textColor="?attr/colorPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:background="@color/ios_separator" />

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="32dp">


        <!-- Title + notes -->
        <com.google.android.material.card.MaterialCardView
            style="@style/IosGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:hint="Title"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences"
                    android:minHeight="50dp"
                    android:paddingHorizontal="16dp"
                    android:textColor="@color/ios_label"
                    android:textColorHint="@color/ios_secondary"
                    android:textSize="17sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0.6dp"
                    android:layout_marginStart="16dp"
                    android:background="@color/ios_separator" />

                <EditText
                    android:id="@+id/notes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:gravity="top"
                    android:hint="Notes (account no., amount, steps…)"
                    android:importantForAutofill="no"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minHeight="80dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:textColor="@color/ios_label"
                    android:textColorHint="@color/ios_secondary"
                    android:textSize="17sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Date + time -->
        <TextView
            style="@style/IosGroupLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Alarm" />

        <com.google.android.material.card.MaterialCardView
            style="@style/IosGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include android:id="@+id/row_date" layout="@layout/item_form_row" />
                <include layout="@layout/divider_inset" />
                <include android:id="@+id/row_time" layout="@layout/item_form_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Repeat + early reminder -->
        <com.google.android.material.card.MaterialCardView
            style="@style/IosGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include android:id="@+id/row_repeat" layout="@layout/item_form_row" />
                <include layout="@layout/divider_inset" />
                <include android:id="@+id/row_early" layout="@layout/item_form_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Important -->
        <com.google.android.material.card.MaterialCardView
            style="@style/IosGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <LinearLayout
                android:id="@+id/row_important"
                style="@style/IosRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/important_icon"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_icon_square"
                    android:importantForAccessibility="no"
                    android:padding="5dp"
                    android:src="@drawable/ic_flag" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:paddingVertical="12dp"
                    android:text="Important"
                    android:textColor="@color/ios_label"
                    android:textSize="17sp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/important"
                    style="@style/IosSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="6dp"
            android:text="Important tasks ring again every 10 minutes until you mark them done."
            android:textColor="@color/ios_secondary"
            android:textSize="13sp" />

        <!-- Delete (edit only) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/delete_group"
            style="@style/IosGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/delete"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:text="Delete Task"
                android:textColor="@color/ios_red"
                android:textSize="17sp" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
</LinearLayout>
