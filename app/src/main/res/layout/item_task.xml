<?xml version="1.0" encoding="utf-8"?>
<!-- Compact task row: tick | title + details | time. The adapter sets the rounded background. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:stateListAnimator="@animator/press_shrink">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/check"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="@string/ui_mark_done"
            android:padding="8dp"
            android:src="@drawable/ic_circle_empty" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal">

                <!-- Full title, wraps onto more lines (never cut off with "…") -->
                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/ios_label"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="!!"
                    android:textColor="@color/ios_orange"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/repeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/ios_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Time column, e.g. "10:00 AM / in 2 h" -->
        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="@color/ios_secondary"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Hairline divider, indented like iOS -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="0.6dp"
        android:layout_marginStart="42dp"
        android:background="@color/ios_separator" />
</LinearLayout>
