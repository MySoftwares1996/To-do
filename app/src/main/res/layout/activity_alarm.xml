<?xml version="1.0" encoding="utf-8"?>
<!-- Alarm screen, "priority glow": soft tinted night background (set in code),
     rippling bell, frosted task card, soft Done and three equal snooze pills. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alarm_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="44dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:baselineAligned="true"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:textColor="@color/white"
            android:textSize="72sp" />

        <TextClock
            android:id="@+id/ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:alpha="0.65"
            android:fontFamily="sans-serif-light"
            android:format12Hour="a"
            android:format24Hour="a"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.6"
        android:format12Hour="EEEE, d MMM"
        android:format24Hour="EEEE, d MMM"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bell with soft ripples (rings animated from code) -->
    <FrameLayout
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:clipChildren="false">

        <View
            android:id="@+id/ripple1"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center" />

        <View
            android:id="@+id/ripple2"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center" />

        <FrameLayout
            android:id="@+id/bell_disc"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/bell"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bell_big" />
        </FrameLayout>
    </FrameLayout>

    <!-- Frosted task card -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="18dp">

        <TextView
            android:id="@+id/important"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:lineSpacingMultiplier="1.1"
            android:maxLines="3"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/due"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.6"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0.6"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="3"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <!-- Three small dots in the glow colours (decoration, like the preview) -->
        <LinearLayout
            android:id="@+id/dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/done"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@drawable/bg_alarm_done"
        android:fontFamily="sans-serif-medium"
        android:foreground="?android:attr/selectableItemBackground"
        android:gravity="center"
        android:text="@string/alarm_done"
        android:textColor="@color/alarm_done_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/snooze10"
            style="@style/AlarmSnoozePill"
            android:layout_marginEnd="5dp"
            android:text="@string/ui_10_min" />

        <TextView
            android:id="@+id/snooze60"
            style="@style/AlarmSnoozePill"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:text="@string/ui_1_hour" />

        <TextView
            android:id="@+id/snooze_more"
            style="@style/AlarmSnoozePill"
            android:layout_marginStart="5dp"
            android:text="@string/ui_more" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.45"
        android:text="@string/alarm_snooze_hint"
        android:textColor="@color/white"
        android:textSize="12sp" />
</LinearLayout>
