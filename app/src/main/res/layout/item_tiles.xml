<?xml version="1.0" encoding="utf-8"?>
<!-- Summary tiles: Today, Upcoming, Important, All -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <include android:id="@+id/tile_today" layout="@layout/item_tile"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" />

        <include android:id="@+id/tile_upcoming" layout="@layout/item_tile"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <include android:id="@+id/tile_important" layout="@layout/item_tile"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" />

        <include android:id="@+id/tile_all" layout="@layout/item_tile"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" />
    </LinearLayout>
</LinearLayout>
